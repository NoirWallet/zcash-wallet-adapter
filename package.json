{
  "name": "@noir-wallet/adapter",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./noir-wallet": {
      "types": "./dist/wallets/noir-wallet/index.d.ts",
      "import": "./dist/wallets/noir-wallet/index.js"
    },
    "./cross-chain-dex": {
      "types": "./dist/cross-chain-dex/index.d.ts",
      "import": "./dist/cross-chain-dex/index.js"
    },
    "./cross-chain-lending": {
      "types": "./dist/cross-chain-lending/index.d.ts",
      "import": "./dist/cross-chain-lending/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@rhea-finance/cross-chain-aggregation-dex": "2.0.3",
    "@rhea-finance/cross-chain-sdk": "0.1.19"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
